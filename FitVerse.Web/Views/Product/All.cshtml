@model IEnumerable<FitVerse.Web.ViewModels.Product.ProductCardViewModel>
@{
    ViewData["Title"] = "All Products";
}

@section Styles {
    <link rel="stylesheet" href="~/css/all-products-style.css" />
}

<div class="floating-elements">
    <div class="floating-shape"></div>
    <div class="floating-shape"></div>
    <div class="floating-shape"></div>
</div>

<div class="hero-header">
    <h1 class="hero-title">FitVerse</h1>
    <p class="hero-subtitle">Discover Your Perfect FitVerse Outfit</p>
</div>

@if (User?.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
{
    <div class="admin-actions">
        <a asp-action="Add" class="btn-create">
            <span>✨</span>
            Create New Product
        </a>
    </div>
}

<div class="products-container">
    @if (Model != null && Model.Any())
    {
        <div class="products-grid">
            @foreach (var item in Model)
            {
                <div class="product-card">
                    <div class="product-image-container">
                        <img src="@item.ImageUrl" alt="@item.Name" class="product-image" />
                        <div class="product-image-overlay"></div>
                    </div>
                    <div class="product-content">
                        <h3 class="product-name">@item.Name</h3>
                        <div class="product-price">$@item.Price</div>
                        <div class="product-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary">
                                View Details
                            </a>
                            @if (User?.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary">
                                    Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">
                                    Delete
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="no-products">
            <div class="no-products-icon">🏋️</div>
            <p>No products available yet. Check back soon for amazing Collection !</p>
        </div>
    }
</div>
