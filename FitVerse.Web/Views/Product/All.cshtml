@model IEnumerable<FitVerse.Web.ViewModels.Product.ProductCardViewModel>

@{
    ViewData["Title"] = "All Products";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Ensure correct layout is used
}

<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #f8f9fa; /* Light background */
        color: #333;
    }

    .products-list-header {
        text-align: center;
        margin-bottom: 40px;
        margin-top: 30px;
    }

        .products-list-header h1 {
            font-size: 2.8em;
            font-weight: 700;
            color: #2c3e50;
        }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); /* Responsive grid */
        gap: 30px;
    }

    .product-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        height: 100%; /* Ensure all cards in a row have same height */
        display: flex;
        flex-direction: column;
    }

        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.12);
        }

        .product-card a {
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

    .product-card-img-container {
        position: relative;
        width: 100%;
        padding-top: 100%; /* 1:1 Aspect Ratio */
        overflow: hidden;
        border-bottom: 1px solid #eee;
    }

    .product-card img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .product-card:hover img {
        transform: scale(1.05);
    }

    .product-card-body {
        padding: 20px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        text-align: center;
    }

    .product-card-title {
        font-size: 1.2em;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 10px;
        height: 2.4em; /* Limit title to 2 lines */
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .product-card-price {
        font-size: 1.4em;
        font-weight: 700;
        color: #3a86ff; /* Primary color */
        margin-top: auto; /* Push price to bottom */
    }

    /* Pagination */
    .pagination-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        margin-top: 50px;
        margin-bottom: 30px;
    }

    .pagination-link {
        padding: 10px 18px;
        border: 1px solid #ddd;
        border-radius: 8px;
        text-decoration: none;
        color: #3a86ff;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .pagination-link:hover:not(.active):not(.disabled) {
            background-color: #e2f0ff;
        }

        .pagination-link.active {
            background-color: #3a86ff;
            color: white;
            border-color: #3a86ff;
            pointer-events: none; /* Disable click on active page */
        }

        .pagination-link.disabled {
            color: #ccc;
            pointer-events: none;
            background-color: #f8f9fa;
            border-color: #eee;
        }

    /* Message for no products */
    .no-products-message {
        text-align: center;
        padding: 50px;
        background-color: #f0f8ff;
        border: 1px solid #cceeff;
        border-radius: 12px;
        margin-top: 50px;
        color: #555;
        font-size: 1.2em;
    }

        .no-products-message h4 {
            color: #3a86ff;
            font-weight: 600;
            margin-bottom: 15px;
        }
</style>

<div class="container py-5">
    <div class="products-list-header">
        <h1>@ViewData["Title"]</h1>
        @if (Context.Request.Query.ContainsKey("category") && !string.IsNullOrEmpty(Context.Request.Query["category"]))
        {
            <p class="lead">Showing products in category: <strong>@Context.Request.Query["category"]</strong></p>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="no-products-message">
            <h4>No Products Found</h4>
            <p>It looks like there are no products available at the moment, or your filter criteria matched no items.</p>
            <p>Please check back later or try a different category.</p>
            <a asp-action="All" class="btn btn-primary mt-3">View All Products</a>
        </div>
    }
    else
    {
        <div class="product-grid">
            @foreach (var item in Model)
            {
                <div class="product-card">
                    <a asp-action="Details" asp-route-id="@item.Id">
                        <div class="product-card-img-container">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@Url.Content(item.ImageUrl)" alt="@item.Name" />
                            }
                            else
                            {
                                <img src="https://placehold.co/400x400/cccccc/333333?text=No+Image" alt="No Image" />
                            }
                        </div>
                        <div class="product-card-body">
                            <h2 class="product-card-title">@Html.DisplayFor(modelItem => item.Name)</h2>
                            <p class="product-card-price">@Html.DisplayFor(modelItem => item.Price)</p>
                        </div>
                    </a>
                </div>
            }
        </div>

        @* Pagination Controls *@
        var currentPage = (int)ViewBag.CurrentPage;
        var totalPages = (int)ViewBag.TotalPages;
        var currentCategory = Context.Request.Query["category"];

        <div class="pagination-container">
            <a asp-action="All"
               asp-route-page="@(currentPage - 1)"
               asp-route-category="@currentCategory"
               class="pagination-link @(ViewBag.HasPreviousPage ? "" : "disabled")">Previous</a>

            @for (int i = 1; i <= totalPages; i++)
            {
                <a asp-action="All"
                   asp-route-page="@i"
                   asp-route-category="@currentCategory"
                   class="pagination-link @(i == currentPage ? "active" : "")">@i</a>
            }

            <a asp-action="All"
               asp-route-page="@(currentPage + 1)"
               asp-route-category="@currentCategory"
               class="pagination-link @(ViewBag.HasNextPage ? "" : "disabled")">Next</a>
        </div>
    }
</div>
