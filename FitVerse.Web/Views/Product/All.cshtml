@model IEnumerable<FitVerse.Web.ViewModels.Product.ProductCardViewModel>
@{
    ViewData["Title"] = "All Products";
}

<style>
    :root {
        --primary-dark: #212529;
        --accent-sage: #8c907e;
        --pure-white: #ffffff;
        --light-sage: rgba(140, 144, 126, 0.1);
        --sage-border: rgba(140, 144, 126, 0.2);
        --dark-transparent: rgba(33, 37, 41, 0.9);
        --shadow-soft: 0 8px 32px rgba(33, 37, 41, 0.15);
        --shadow-hover: 0 20px 60px rgba(33, 37, 41, 0.25);
        --text-light: #ffffff;
        --text-dark: #212529;
        --sage-gradient: linear-gradient(135deg, #8c907e 0%, #a5a995 100%);
        --dark-gradient: linear-gradient(135deg, #212529 0%, #2a2e32 100%);
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: var(--primary-gradient);
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        overflow-x: hidden;
    }

        /* Animated background particles */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 20% 80%, rgba(120, 119, 198, 0.3) 0%, transparent 50%), radial-gradient(circle at 80% 20%, rgba(255, 119, 198, 0.3) 0%, transparent 50%), radial-gradient(circle at 40% 40%, rgba(120, 219, 255, 0.3) 0%, transparent 50%);
            animation: particleFloat 20s ease-in-out infinite;
            z-index: -1;
        }



    {
        transform: translateY(0px) rotate(0deg);
    }

    33% {
        transform: translateY(-30px) rotate(120deg);
    }

    66% {
        transform: translateY(20px) rotate(240deg);
    }

    }

    .hero-header {
        text-align: center;
        padding: 4rem 2rem 2rem;
        position: relative;
        overflow: hidden;
    }

    .hero-title {
        font-size: clamp(3rem, 8vw, 6rem);
        font-weight: 900;
        background: linear-gradient(45deg, #212529, #8c907e, #212529);
        background-size: 200% 200%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: shimmer 3s ease-in-out infinite;
        text-shadow: 0 0 20px rgba(33, 37, 41, 0.1);
        margin-bottom: 1rem;
        letter-spacing: -2px;
    }

    .hero-subtitle {
        font-size: 1.5rem;
        color: #212529;
        margin-bottom: 2rem;
        animation: fadeInUp 1s ease-out 0.5s both;
    }

  

    {
        background-position: -200% 0;
    }

    100% {
        background-position: 200% 0;
    }

    }



    {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .admin-actions {
        text-align: center;
        margin: 2rem 0;
        animation: fadeInUp 1s ease-out 0.7s both;
    }

    .btn-create {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 1rem 2rem;
        background: var(--sage-gradient);
        color: white;
        text-decoration: none;
        border-radius: 50px;
        font-weight: 600;
        font-size: 1.1rem;
        box-shadow: var(--shadow-soft);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

        .btn-create::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s;
        }

        .btn-create:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-hover);
            color: white;
            text-decoration: none;
        }

            .btn-create:hover::before {
                left: 100%;
            }

    .products-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem;
    }

    .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
    }

    .product-card {
        background: var(--pure-white);
        border: 1px solid rgba(140, 144, 126, 0.15);
        border-radius: 24px;
        padding: 0;
        box-shadow: var(--shadow-soft);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        animation: fadeInUp 0.6s ease-out both;
    }

        .product-card:nth-child(even) {
            animation-delay: 0.1s;
        }

        .product-card:nth-child(3n) {
            animation-delay: 0.2s;
        }

        .product-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--sage-gradient);
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .product-card:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: var(--shadow-hover);
            border-color: var(--accent-sage);
        }

            .product-card:hover::before {
                transform: scaleX(1);
            }

    .product-image-container {
        position: relative;
        height: 250px;
        overflow: hidden;
        border-radius: 20px 20px 0 0;
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .product-card:hover .product-image {
        transform: scale(1.1);
    }

    .product-image-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.3) 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .product-card:hover .product-image-overlay {
        opacity: 1;
    }

    .product-content {
        padding: 1.5rem;
    }

    .product-name {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 0.5rem;
        line-height: 1.3;
    }

    .product-price {
        font-size: 1.8rem;
        font-weight: 800;
        background: var(--sage-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 1.5rem;
    }

    .product-actions {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .btn {
        padding: 0.6rem 1.2rem;
        border: none;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

    .btn-primary {
        background: var(--sage-gradient);
        color: white;
    }

    .btn-secondary {
        background: var(--primary-dark);
        color: white;
        border: 1px solid var(--primary-dark);
    }

    .btn-danger {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: white;
    }

    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(33, 37, 41, 0.2);
        text-decoration: none;
        color: white;
    }

    .btn-secondary:hover {
        background: #343a40;
        color: white;
    }

    .floating-elements {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: -1;
    }

    .floating-shape {
        position: absolute;
        opacity: 0.1;
        animation: float 20s infinite linear;
    }

        .floating-shape:nth-child(1) {
            top: 20%;
            left: 10%;
            width: 60px;
            height: 60px;
            background: var(--sage-gradient);
            border-radius: 50%;
            animation-delay: 0s;
        }

        .floating-shape:nth-child(2) {
            top: 60%;
            right: 15%;
            width: 40px;
            height: 40px;
            background: rgba(33, 37, 41, 0.1);
            border-radius: 50%;
            animation-delay: 5s;
        }

        .floating-shape:nth-child(3) {
            top: 80%;
            left: 70%;
            width: 30px;
            height: 30px;
            background: linear-gradient(45deg, #8c907e, #a5a995);
            border-radius: 50%;
            animation-delay: 10s;
        }

  

    {
        transform: translateY(0px) rotate(0deg);
    }

    33% {
        transform: translateY(-20px) rotate(120deg);
    }

    66% {
        transform: translateY(10px) rotate(240deg);
    }

    100% {
        transform: translateY(0px) rotate(360deg);
    }

    }

    .no-products {
        text-align: center;
        padding: 4rem 2rem;
        color: #212529;
        font-size: 1.2rem;
    }

    .no-products-icon {
        font-size: 4rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }

  

    {
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
    }

    .hero-header {
        padding: 2rem 1rem 1rem;
    }

    .products-container {
        padding: 1rem;
    }

    .product-actions {
        flex-direction: column;
    }

    .btn {
        text-align: center;
    }

    }
</style>

<div class="floating-elements">
    <div class="floating-shape"></div>
    <div class="floating-shape"></div>
    <div class="floating-shape"></div>
</div>

<div class="hero-header">
    <h1 class="hero-title">FitVerse</h1>
    <p class="hero-subtitle">Discover Your Perfect FitVerse Outfit</p>
</div>

@if (User?.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
{
    <div class="admin-actions">
        <a asp-action="Add" class="btn-create">
            <span>✨</span>
            Create New Product
        </a>
    </div>
}

<div class="products-container">
    @if (Model != null && Model.Any())
    {
        <div class="products-grid">
            @foreach (var item in Model)
            {
                <div class="product-card">
                    <div class="product-image-container">
                        <img src="@item.ImageUrl" alt="@item.Name" class="product-image" />
                        <div class="product-image-overlay"></div>
                    </div>
                    <div class="product-content">
                        <h3 class="product-name">@item.Name</h3>
                        <div class="product-price">$@item.Price</div>
                        <div class="product-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary">
                                View Details
                            </a>
                            @if (User?.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary">
                                    Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">
                                    Delete
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="no-products">
            <div class="no-products-icon">🏋️</div>
            <p>No products available yet. Check back soon for amazing Collection !</p>
        </div>
    }
</div>