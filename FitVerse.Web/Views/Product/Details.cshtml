@model FitVerse.Web.ViewModels.Product.ProductDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}
@section Styles {
    <link rel="stylesheet" type="text/css" href="/css/ProductDetails.css" />
}

<main>
    <!-- Floating background elements -->
    <div class="floating-elements">
        <div class="floating-shape"></div>
        <div class="floating-shape"></div>
        <div class="floating-shape"></div>
    </div>

    <div class="product-details-container">
        <div class="product-card">
            <!-- Image Section -->
            <div class="product-image-section">
                @if (Model.DiscountPercentage.HasValue && Model.DiscountPercentage.Value > 0)
                {
                    <span class="product-badge">@Model.DiscountPercentage.Value% OFF</span>
                }
                @if (Model.IsNewArrival)
                {
                    <span class="badge-new-arrival">NEW ARRIVAL</span>
                }
                @if (Model.IsOnSale && !(Model.DiscountPercentage.HasValue && Model.DiscountPercentage.Value > 0))
                {
                    <span class="badge-on-sale">ON SALE!</span>
                }
                <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid" />
            </div>

            <!-- Product Info Section -->
            <div class="product-info-section">
                <nav aria-label="breadcrumb" class="breadcrumb-custom">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-action="ParentCategory" 
                               asp-controller="Product" 
                               asp-route-parentCategory="@Model.ParentCategoryName">
                                @Model.ParentCategoryName
                            </a>
                        </li>
                        <li class="breadcrumb-item">
                            <a asp-action="ParentCategory" 
                               asp-controller="Product" 
                               asp-route-parentCategory="@Model.ParentCategoryName" 
                               asp-route-category="@Model.CategoryName">
                                @Model.CategoryName
                            </a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
                    </ol>
                </nav>

                <h1 class="product-title">@Model.Name</h1>

                <div class="product-meta">
                    <span class="product-material">@Model.Material</span>
                </div>

                <div class="price-section">
                    <span class="current-price">EGP @Model.EffectivePrice.ToString("F2")</span>
                    @if (Model.DiscountPercentage.HasValue && Model.DiscountPercentage.Value > 0)
                    {
                        <span class="original-price">EGP @Model.Price.ToString("F2")</span>
                        <span class="discount-badge">Save EGP @((Model.Price - Model.EffectivePrice).ToString("F2"))</span>
                    }
                </div>

                <div class="product-description">
                    @Html.Raw(Model.Description)
                </div>

                <div class="stock-info @(Model.StockQuantity > 3 ? "available" : (Model.StockQuantity > 0 && Model.StockQuantity <= 3 ? "low" : "out-of-stock"))">
                    <i class="fas @(Model.StockQuantity > 3 ? "fa-check-circle" : (Model.StockQuantity > 0 && Model.StockQuantity <= 3 ? "fa-exclamation-triangle" : "fa-times-circle"))"></i>
                    @(Model.StockQuantity > 0 ? $"{Model.StockQuantity} items available" : "Out of Stock")
                </div>

                <div class="product-features">
                    <div class="feature-item">
                        <span class="feature-icon">
                            <i class="fas fa-check"></i>
                        </span>
                        <span class="feature-text">Premium @Model.Material material for durability</span>
                    </div>
                    <div class="feature-item">
                        <span class="feature-icon">
                            <i class="fas fa-check"></i>
                        </span>
                        <span class="feature-text">Designed for optimal performance</span>
                    </div>
                    <div class="feature-item">
                        <span class="feature-icon">
                            <i class="fas fa-check"></i>
                        </span>
                        <span class="feature-text">Free shipping on orders over EGP 50</span>
                    </div>
                </div>

                <div class="add-to-cart-card">
                    <h4 class="add-to-cart-title">Add to Cart</h4>
                    @if (Model.StockQuantity > 0)
                    {
                        var addToCartUrl = Url.Action(
                            action: "AddToCartAction",
                            controller: "CartItem",
                            values: new { id = Model.Id }
                        );

                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <form asp-controller="CartItem"
                                  asp-action="AddToCartAction"
                                  method="post">

                                <input type="hidden" asp-for="Id" name="PId" />

                                <div class="quantity-selector">
                                    <button type="button" class="quantity-btn minus" onclick="decrementQuantity(); updatePrice();">
                                        <i class="fas fa-minus"></i>
                                    </button>
                                    <input type="number"
                                           asp-for="SelectedQuantity"
                                           class="quantity-input"
                                           min="1"
                                           max="@Model.StockQuantity"
                                           value="1"
                                           id="quantityInput"
                                           data-base-price="@Model.EffectivePrice"
                                           data-max="@Model.StockQuantity" />
                                    <button type="button" class="quantity-btn plus" onclick="incrementQuantity(); updatePrice();">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>

                                <button type="submit" class="btn-add-to-cart">
                                    <i class="fas fa-shopping-cart"></i>
                                    Add to Cart - <span id="effectivePrice">EGP @Model.EffectivePrice.ToString("F2")</span>
                                </button>
                            </form>
                        }
                        else
                        {
                            <!-- user is anonymous: send them to Login, with a ReturnUrl pointing back to AddToCart -->
                            <div class="quantity-selector">
                                <button type="button" class="quantity-btn minus" onclick="decrementQuantity(); updatePrice();">
                                    <i class="fas fa-minus"></i>
                                </button>
                                <input type="number"
                                       class="quantity-input"
                                       min="1"
                                       max="@Model.StockQuantity"
                                       value="1"
                                       id="quantityInput"
                                       data-base-price="@Model.EffectivePrice"
                                       data-max="@Model.StockQuantity" />
                                <button type="button" class="quantity-btn plus" onclick="incrementQuantity(); updatePrice();">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>

                            <a asp-controller="Account"
                               asp-action="Login"
                               asp-route-returnUrl="@addToCartUrl"
                               class="btn-add-to-cart">
                                <i class="fas fa-shopping-cart"></i>
                                Add to Cart - <span id="effectivePrice">EGP @Model.EffectivePrice.ToString("F2")</span>
                            </a>
                        }
                    }
                    else
                    {
                        <div class="alert alert-warning" role="alert" style="background: linear-gradient(135deg, rgba(255, 193, 7, 0.1) 0%, rgba(255, 149, 5, 0.1) 100%); border: 1px solid rgba(255, 193, 7, 0.2); border-radius: 15px; padding: 1rem; margin-bottom: 1rem; color: #856404;">
                            <i class="fas fa-exclamation-circle me-2"></i> This product is currently out of stock.
                        </div>
                        <button type="button" class="btn-add-to-cart" disabled>
                            <i class="fas fa-bell"></i>
                            Notify Me When Available
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Declare these variables in global scope
        let basePrice;
        let maxQuantity;

        document.addEventListener('DOMContentLoaded', function() {
            const qtyInput = document.getElementById('quantityInput');
            const priceSpan = document.getElementById('effectivePrice');

            // Initialize global variables
            if (qtyInput) {
                basePrice = parseFloat(qtyInput.dataset.basePrice);
                maxQuantity = parseInt(qtyInput.dataset.max, 10);

                // Initialize price display
                updatePrice();

                // Add input event listener
                qtyInput.addEventListener('input', function() {
                    let value = parseInt(this.value) || 1;
                    if (value < 1) this.value = 1;
                    if (value > maxQuantity) this.value = maxQuantity;
                    updatePrice();
                });
            }
        });

        // Now these functions can access the global variables
        function incrementQuantity() {
            const input = document.getElementById('quantityInput');
            if (input) {
                let value = parseInt(input.value) || 1;
                if (value < maxQuantity) {
                    input.value = value + 1;
                    updatePrice();
                }
            }
        }

        function decrementQuantity() {
            const input = document.getElementById('quantityInput');
            if (input) {
                let value = parseInt(input.value) || 1;
                if (value > 1) {
                    input.value = value - 1;
                    updatePrice();
                }
            }
        }

        function updatePrice() {
            const quantityInput = document.getElementById('quantityInput');
            const effectivePriceSpan = document.getElementById('effectivePrice');
            
            if (quantityInput && effectivePriceSpan) {
                const quantity = parseInt(quantityInput.value) || 1;
                const totalPrice = (basePrice * quantity).toFixed(2);
                effectivePriceSpan.textContent = 'EGP ' + totalPrice;
            }
        }

        // Add smooth scrolling and animations
        document.addEventListener('DOMContentLoaded', function() {
            // Add intersection observer for animations
            const observerOptions = {
                threshold: 0.1,
                rootMargin: '0px 0px -50px 0px'
            };

            const observer = new IntersectionObserver(function(entries) {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.animationPlayState = 'running';
                    }
                });
            }, observerOptions);

            // Observe animated elements
            const animatedElements = document.querySelectorAll('.product-card, .feature-item, .add-to-cart-card');
            animatedElements.forEach(el => {
                observer.observe(el);
            });
        });
    </script>
}