@model IEnumerable<FitVerse.Web.Models.Banner>

@{
    ViewData["Title"] = "Manage Banners";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Ensure correct layout is used
}

<style>
    /* Basic styling for index tables */
    body {
        font-family: 'Inter', sans-serif;
        background-color: #f0f2f5;
        color: #333;
    }

    .table-container {
        background-color: #fff;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
        margin-top: 30px;
        overflow-x: auto; /* For responsive tables */
    }

    h1 {
        color: #2c3e50;
        font-weight: 700;
        margin-bottom: 25px;
    }

    .create-new-link {
        margin-bottom: 20px;
        display: inline-block;
        padding: 10px 20px;
        background-color: #28a745; /* Success color */
        color: white;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(40, 167, 69, 0.2);
    }

        .create-new-link:hover {
            background-color: #218838;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(40, 167, 69, 0.3);
        }

    .table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

        .table th, .table td {
            padding: 12px 15px;
            border: 1px solid #dee2e6;
            vertical-align: middle;
            text-align: left;
        }

        .table th {
            background-color: #e9ecef;
            font-weight: 700;
            color: #495057;
            text-transform: uppercase;
            font-size: 0.9em;
        }

        .table tbody tr:nth-child(even) {
            background-color: #f8f9fa;
        }

        .table tbody tr:hover {
            background-color: #e2f0ff; /* Light blue on hover */
        }

        .table td img {
            max-width: 80px;
            height: auto;
            border-radius: 4px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

    .action-links a {
        margin-right: 15px;
        text-decoration: none;
        font-weight: 500;
        transition: color 0.3s ease;
    }

    .action-links .edit {
        color: #3a86ff; /* Primary color */
    }

        .action-links .edit:hover {
            color: #2a6ae0;
        }

    .action-links .details {
        color: #6c757d; /* Secondary color */
    }

        .action-links .details:hover {
            color: #5a6268;
        }

    .action-links .delete {
        color: #dc3545; /* Danger color */
    }

        .action-links .delete:hover {
            color: #c82333;
        }
</style>

<div class="container py-5">
    <div class="table-container">
        <h1>Manage Banners</h1>

        <p>
            <a asp-action="Create" class="create-new-link">Create New Banner</a>
        </p>
        <table class="table">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Title)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Description)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ImageUrl)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IsActive)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CreatedAt)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Title)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Description)
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@Url.Content(item.ImageUrl)" alt="Banner Image" />
                            }
                            else
                            {
                                <span>No Image</span>
                            }
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.IsActive)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.CreatedAt)
                        </td>
                        <td class="action-links">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="edit">Edit</a> |
                            <a asp-action="Details" asp-route-id="@item.Id" class="details">Details</a> |
                            <a asp-action="Delete" asp-route-id="@item.Id" class="delete">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
