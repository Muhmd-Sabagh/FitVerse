@model List<FitVerse.Web.Models.Order>

@{
    ViewData["Title"] = "My Orders";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Ensure correct layout is used
}

<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #f3f4f6; /* Light gray background */
    }

    .orders-container {
        background-color: #fff;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        padding: 2.5rem;
    }

    .table-header-custom th {
        background-color: #e9ecef;
        font-weight: 700;
        color: #495057;
        text-transform: uppercase;
        font-size: 0.9em;
    }

    .table-row-custom td {
        padding: 12px 15px;
        border-bottom: 1px solid #dee2e6;
        vertical-align: middle;
    }

    .table-row-custom:last-child td {
        border-bottom: none;
    }

    .table-row-custom:hover {
        background-color: #f8f9fa;
    }
</style>

<div class="container mx-auto p-4 sm:p-6 lg:p-8">
    <div class="orders-container">
        <h1 class="text-3xl font-bold text-gray-800 mb-6 text-center">Your Orders</h1>
        <hr class="mb-6 border-gray-200">

        @if (Model == null || !Model.Any())
        {
            <div class="bg-yellow-100 border-l-4 border-yellow-500 text-yellow-700 p-4 rounded-md" role="alert">
                <p class="font-bold">No Orders Found</p>
                <p>It looks like you haven't placed any orders yet. Start shopping to create your first order!</p>
            </div>
            <div class="mt-6 text-center">
                <a asp-controller="Product" asp-action="All" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    Go to Shop
                </a>
            </div>
        }
        else
        {
            <div class="bg-white rounded-lg shadow-xl overflow-hidden">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="table-header-custom">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-left">Order #</th>
                            <th scope="col" class="px-6 py-3 text-left">Order Date</th>
                            <th scope="col" class="px-6 py-3 text-left">Total Amount</th>
                            <th scope="col" class="px-6 py-3 text-left">Status</th>
                            <th scope="col" class="px-6 py-3 text-left">Customer Name</th>
                            <th scope="col" class="relative px-6 py-3">
                                <span class="sr-only">Actions</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var order in Model)
                        {
                            <tr class="table-row-custom">
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@order.Id</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@order.OrderDate.ToShortDateString()</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@order.TotalAmount.ToString("C")</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@order.Status</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@order.CustomerName</td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                    <a asp-controller="Checkout" asp-action="OrderDetails" asp-route-id="@order.Id" class="text-indigo-600 hover:text-indigo-900">View Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="mt-6 text-center">
            <a asp-controller="Home" asp-action="Index" class="text-gray-600 hover:text-gray-900 text-sm font-medium">Return to Home</a>
        </div>
    </div>
</div>
