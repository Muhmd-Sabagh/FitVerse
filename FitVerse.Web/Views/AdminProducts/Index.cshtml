@model IEnumerable<Product>

@{
    ViewData["Title"] = "Manage Products";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Ensure correct layout is used
}

<style>
    /* Basic styling for index tables */
    body {
        font-family: 'Inter', sans-serif;
        background-color: #f0f2f5;
        color: #333;
    }
    .table-container {
        background-color: #fff;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
        margin-top: 30px;
        overflow-x: auto; /* For responsive tables */
    }
    h1 {
        color: #2c3e50;
        font-weight: 700;
        margin-bottom: 25px;
    }
    .create-new-link {
        margin-bottom: 20px;
        display: inline-block;
        padding: 10px 20px;
        background-color: #28a745; /* Success color */
        color: white;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(40, 167, 69, 0.2);
    }
    .create-new-link:hover {
        background-color: #218838;
        transform: translateY(-2px);
        box-shadow: 0 6px 15px rgba(40, 167, 69, 0.3);
    }
    .table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }
    .table th, .table td {
        padding: 12px 15px;
        border: 1px solid #dee2e6;
        vertical-align: middle;
        text-align: left;
    }
    .table th {
        background-color: #e9ecef;
        font-weight: 700;
        color: #495057;
        text-transform: uppercase;
        font-size: 0.9em;
    }
    .table tbody tr:nth-child(even) {
        background-color: #f8f9fa;
    }
    .table tbody tr:hover {
        background-color: #e2f0ff; /* Light blue on hover */
    }
    .table td img {
        max-width: 80px;
        height: auto;
        border-radius: 4px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }
    .action-links a {
        margin-right: 15px;
        text-decoration: none;
        font-weight: 500;
        transition: color 0.3s ease;
    }
    .action-links .edit {
        color: #3a86ff; /* Primary color */
    }
    .action-links .edit:hover {
        color: #2a6ae0;
    }
    .action-links .details {
        color: #6c757d; /* Secondary color */
    }
    .action-links .details:hover {
        color: #5a6268;
    }
    .action-links .delete {
        color: #dc3545; /* Danger color */
    }
    .action-links .delete:hover {
        color: #c82333;
    }
    .pagination-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        margin-top: 25px;
    }
    .pagination-link {
        padding: 8px 15px;
        border: 1px solid #ddd;
        border-radius: 8px;
        text-decoration: none;
        color: #3a86ff;
        transition: all 0.3s ease;
    }
    .pagination-link:hover:not(.disabled) {
        background-color: #e2f0ff;
    }
    .pagination-link.active {
        background-color: #3a86ff;
        color: white;
        border-color: #3a86ff;
    }
    .pagination-link.disabled {
        color: #ccc;
        pointer-events: none;
        background-color: #f8f9fa;
        border-color: #eee;
    }
</style>

<div class="container py-5">
    <div class="table-container">
        <h1>Manage Products</h1>

        <p>
            <a asp-action="Create" class="create-new-link">Create New Product</a>
        </p>
        <table class="table">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ImageUrl)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Price)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.StockQuantity)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IsActive)
                    </th>
                    <th>
                        Category
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@Url.Content(item.ImageUrl)" alt="Product Image" />
                            }
                            else
                            {
                                <span>No Image</span>
                            }
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Price)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.StockQuantity)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.IsActive)
                        </td>
                        <td>
                            @(item.Category != null ? item.Category.Name : "N/A")
                        </td>
                        <td class="action-links">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="edit">Edit</a> |
                            <a asp-action="Details" asp-route-id="@item.Id" class="details">Details</a> |
                            <a asp-action="Delete" asp-route-id="@item.Id" class="delete">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @* Pagination Controls *@
        @{
            var currentPage = (int)ViewBag.CurrentPage;
            var totalPages = (int)ViewBag.TotalPages;
        }
        <div class="pagination-container">
            <a asp-action="Index" asp-route-page="@(currentPage - 1)"
               class="pagination-link @(ViewBag.HasPreviousPage ? "" : "disabled")">Previous</a>

            @for (int i = 1; i <= totalPages; i++)
            {
                <a asp-action="Index" asp-route-page="@i"
                   class="pagination-link @(i == currentPage ? "active" : "")">@i</a>
            }

            <a asp-action="Index" asp-route-page="@(currentPage + 1)"
               class="pagination-link @(ViewBag.HasNextPage ? "" : "disabled")">Next</a>
        </div>
    </div>
</div>
