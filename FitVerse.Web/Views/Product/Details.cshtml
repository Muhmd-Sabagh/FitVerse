@model FitVerse.Web.ViewModels.Product.ProductDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml"; // Ensure correct layout is used
}

@section Styles{
    <link rel="stylesheet" type="text/css" href="~/css/ProductDetails.css" />
    <style>
        /* Define variables if not already in ProductDetails.css or site.css */
        :root {
            --primary-color: #3a86ff;
            --secondary-color: #8338ec;
            --accent-color: #ff006e;
            --light-bg: #f8f9fa;
            --dark-text: #212529;
            --gray-text: #6c757d;
            --success-color: #28a745;
            --warning-color: #ffc107;
            --danger-color: #dc3545;
        }

        .product-details-container {
            display: flex;
            flex-wrap: wrap; /* Allow wrapping on small screens */
            align-items: flex-start; /* Align items to the top */
            justify-content: center;
            gap: 40px; /* Space between sections */
            padding: 40px 0;
        }

        .product-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            transition: transform 0.3s ease;
            width: 100%; /* Full width on small screens */
            max-width: 1000px; /* Max width for the entire card container */
            display: flex; /* Flex container for image and info sections */
            flex-direction: row; /* Default to row layout */
        }

        .product-image-section {
            position: relative;
            padding: 30px; /* Reduced padding */
            background: #f8f9fa; /* Light background for image section */
            flex: 1; /* Take available space */
            min-width: 300px; /* Minimum width for image section */
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .product-image-section img {
                max-width: 100%;
                max-height: 400px; /* Max height for image */
                object-fit: contain; /* Ensure image fits without cropping */
                border-radius: 12px;
            }

        .product-info-section {
            flex: 1; /* Take available space */
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: flex-start; /* Align content to the top */
            min-width: 350px; /* Minimum width for info section */
        }

        .product-title {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--dark-text);
            margin-bottom: 10px;
        }

        .product-category {
            font-size: 1.1rem;
            color: var(--gray-text);
            margin-bottom: 20px;
        }

        .product-price-section {
            display: flex;
            align-items: baseline;
            gap: 15px;
            margin-bottom: 20px;
        }

        .original-price {
            font-size: 1.5rem;
            color: var(--gray-text);
            text-decoration: line-through;
        }

        .effective-price {
            font-size: 2.2rem;
            font-weight: 700;
            color: var(--primary-color);
        }

        .product-description {
            font-size: 1.1rem;
            color: var(--dark-text);
            line-height: 1.6;
            margin-bottom: 25px;
        }

        .product-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 25px;
        }

        .meta-item {
            font-size: 0.95rem;
            color: var(--gray-text);
            background-color: var(--light-bg);
            padding: 8px 15px;
            border-radius: 20px;
            border: 1px solid #e0e0e0;
        }

        .quantity-control {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 30px;
        }

            .quantity-control label {
                font-weight: 600;
                color: var(--dark-text);
                margin-right: 5px;
            }

            .quantity-control button {
                background-color: var(--secondary-color);
                color: white;
                border: none;
                border-radius: 8px;
                width: 40px;
                height: 40px;
                font-size: 1.5rem;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                transition: background-color 0.2s ease, transform 0.2s ease;
            }

                .quantity-control button:hover {
                    background-color: #6a2dc4;
                    transform: translateY(-2px);
                }

            .quantity-control input {
                width: 70px;
                text-align: center;
                border: 1px solid #ddd;
                border-radius: 8px;
                padding: 8px;
                font-size: 1.1rem;
            }

        .add-to-cart-btn {
            background-color: var(--primary-color);
            color: white;
            padding: 15px 30px;
            border-radius: 12px;
            border: none;
            font-size: 1.2rem;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
            width: 100%; /* Full width button */
            box-shadow: 0 8px 20px rgba(58, 134, 255, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

            .add-to-cart-btn:hover {
                background-color: #2a6ae0;
                transform: translateY(-3px);
                box-shadow: 0 12px 25px rgba(58, 134, 255, 0.3);
            }

            .add-to-cart-btn i {
                font-size: 1.5rem;
            }

        .out-of-stock-btn {
            background-color: #dc3545; /* Danger color */
            color: white;
            padding: 15px 30px;
            border-radius: 12px;
            border: none;
            font-size: 1.2rem;
            font-weight: 600;
            cursor: not-allowed;
            opacity: 0.7;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .badge-new-arrival {
            background-color: var(--secondary-color);
            color: white;
            padding: 5px 10px;
            border-radius: 8px;
            font-size: 0.8rem;
            font-weight: 600;
            position: absolute;
            top: 20px;
            left: 20px; /* Adjusted position */
            z-index: 10;
        }

        .badge-on-sale {
            background-color: var(--success-color);
            color: white; /* Changed text color to white for better contrast */
            padding: 5px 10px;
            border-radius: 8px;
            font-size: 0.8rem;
            font-weight: 600;
            position: absolute;
            top: 20px;
            right: 20px; /* Adjusted position */
            z-index: 10;
        }

        /* Responsive adjustments */
        @@media (max-width: 992px) {
            .product-card {
                flex-direction: column; /* Stack sections on medium and small screens */
            }
            .product-image-section, .product-info-section {
                min-width: unset;
                width: 100%;
            }
            .product-image-section {
                padding: 20px;
            }
            .product-info-section {
                padding: 30px;
            }
            .product-title {
                font-size: 2rem;
            }
            .effective-price {
                font-size: 1.8rem;
            }
        }
        @@media (max-width: 576px) {
            .product-details-container {
                padding: 20px 0;
            }
            .product-info-section {
                padding: 20px;
            }
            .product-title {
                font-size: 1.8rem;
            }
            .original-price {
                font-size: 1.2rem;
            }
            .effective-price {
                font-size: 1.5rem;
            }
            .add-to-cart-btn {
                font-size: 1rem;
                padding: 12px 20px;
            }
            .quantity-control input {
                width: 60px;
                padding: 6px;
                font-size: 1rem;
            }
        }
    </style>
}

<main class="container product-details-container py-5">
    <div class="product-card">
        <div class="product-image-section">
            @if (Model.IsNewArrival)
            {
                <span class="badge-new-arrival">New Arrival</span>
            }
            @if (Model.IsOnSale)
            {
                <span class="badge-on-sale">On Sale!</span>
            }
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Url.Content(Model.ImageUrl)" alt="@Model.Name" class="img-fluid">
            }
            else
            {
                <img src="https://placehold.co/400x400/cccccc/333333?text=No+Image" alt="No Image" class="img-fluid" />
            }
        </div>

        <div class="product-info-section">
            <h1 class="product-title">@Model.Name</h1>
            <p class="product-category">Category: @Model.CategoryName @if (!string.IsNullOrEmpty(Model.ParentCategoryName)) {<text>(@Model.ParentCategoryName)</text>}</p>

            <div class="product-price-section">
                @if (Model.DiscountPercentage.HasValue && Model.DiscountPercentage > 0)
                {
                    <span class="original-price">@Model.Price.ToString("C")</span>
                }
                <span class="effective-price">@Model.EffectivePrice.ToString("C")</span>
            </div>

            <p class="product-description">@Model.Description</p>

            <div class="product-meta">
                <span class="meta-item">Material: @(string.IsNullOrEmpty(Model.Material) ? "N/A" : Model.Material)</span>
                <span class="meta-item">In Stock: @Model.StockQuantity</span>
            </div>

            @if (Model.StockQuantity > 0)
            {
                <div class="quantity-control">
                    <label for="quantityInput">Quantity:</label>
                    <button type="button" onclick="decrementQuantity()"><i class="fas fa-minus"></i></button>
                    <input type="number" id="quantityInput" value="@Model.SelectedQuantity" min="1" max="@Model.StockQuantity">
                    <button type="button" onclick="incrementQuantity()"><i class="fas fa-plus"></i></button>
                </div>

                <form asp-controller="CartItem" asp-action="Increment" method="get">
                    <input type="hidden" name="PId" value="@Model.Id" />
                    <input type="hidden" name="quantity" id="hiddenQuantityInput" value="1" /> @* Value will be updated by JS *@
                    <button type="submit" class="add-to-cart-btn">
                        <i class="fas fa-shopping-cart"></i> Add to Cart
                    </button>
                </form>
            }
            else
            {
                <button type="button" class="out-of-stock-btn" disabled>
                    <i class="fas fa-exclamation-circle"></i> Out of Stock
                </button>
                <button type="button" class="add-to-cart-btn mt-3" style="background-color: #ffc107;" onclick="alert('You can enable a "Notify Me" feature here to be alerted when the product is back in stock.')">
                   <i class="fas fa-bell"></i> Notify Me When Available
                </button>
            }
        </div>
    </div>
</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function updateHiddenQuantity() {
            const quantityInput = document.getElementById('quantityInput');
            const hiddenQuantityInput = document.getElementById('hiddenQuantityInput');
            if (quantityInput && hiddenQuantityInput) {
                hiddenQuantityInput.value = quantityInput.value;
            }
        }

        function incrementQuantity() {
            const input = document.getElementById('quantityInput');
            const max = parseInt(input.max);
            let value = parseInt(input.value);
            if (value < max) {
                input.value = value + 1;
            }
            updateHiddenQuantity();
        }

        function decrementQuantity() {
            const input = document.getElementById('quantityInput');
            let value = parseInt(input.value);
            if (value > 1) {
                input.value = value - 1;
            }
            updateHiddenQuantity();
        }

        // Validate quantity input on change
        document.getElementById('quantityInput').addEventListener('change', function() {
            let value = parseInt(this.value);
            const max = parseInt(this.max);
            const min = parseInt(this.min);

            if (isNaN(value) || value < min) {
                this.value = min;
            } else if (value > max) {
                this.value = max;
            }
            updateHiddenQuantity(); // Update hidden input after validation
        });

        // Initialize hidden quantity on page load
        document.addEventListener('DOMContentLoaded', updateHiddenQuantity);
    </script>
}
