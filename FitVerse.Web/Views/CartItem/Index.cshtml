@model IEnumerable<FitVerse.Web.ViewModels.Cart.CartItem_ViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml"; // Ensure correct layout is used
    ViewData["Title"] = "My Cart";
}

<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #f0f2f5;
        color: #333;
    }
    .cart-container {
        background-color: #fff;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
        margin-top: 30px;
        overflow-x: auto;
    }
    h1 {
        color: #2c3e50;
        font-weight: 700;
        margin-bottom: 25px;
    }
    .table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }
    .table th, .table td {
        padding: 12px 15px;
        border: 1px solid #dee2e6;
        vertical-align: middle;
        text-align: left;
    }
    .table th {
        background-color: #e9ecef;
        font-weight: 700;
        color: #495057;
        text-transform: uppercase;
        font-size: 0.9em;
    }
    .table tbody tr:nth-child(even) {
        background-color: #f8f9fa;
    }
    .table tbody tr:hover {
        background-color: #e2f0ff;
    }
    .table td img {
        max-width: 80px;
        height: auto;
        border-radius: 4px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }
    .action-buttons .btn {
        margin-right: 8px;
        border-radius: 6px;
        padding: 8px 15px;
        font-size: 0.95em;
        font-weight: 600;
        transition: all 0.2s ease-in-out;
    }
    .btn-primary {
        background-color: #3a86ff;
        border-color: #3a86ff;
        color: white;
    }
    .btn-primary:hover {
        background-color: #2a6ae0;
        border-color: #2a6ae0;
    }
    .btn-warning {
        background-color: #ffc107;
        border-color: #ffc107;
        color: #333;
    }
    .btn-warning:hover {
        background-color: #e0a800;
        border-color: #d39e00;
    }
    .btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
        color: white;
    }
    .btn-danger:hover {
        background-color: #c82333;
        border-color: #bd2130;
    }
    .total-cost {
        font-size: 1.5em;
        font-weight: 700;
        text-align: right;
        margin-top: 30px;
        padding-right: 15px;
    }
    .cart-actions {
        display: flex;
        justify-content: flex-end;
        gap: 15px;
        margin-top: 20px;
    }
    .cart-actions .btn {
        padding: 12px 25px;
        font-size: 1.1em;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }
    .empty-cart-message {
        background-color: #fff3cd;
        border-left: 5px solid #ffc107;
        color: #856404;
        padding: 20px;
        border-radius: 8px;
        margin-top: 20px;
        text-align: center;
        font-weight: 500;
    }
</style>

<div class="container py-5">
    <div class="cart-container">
        <h1>My Shopping Cart</h1>

        @if (!Model.Any())
        {
            <div class="empty-cart-message">
                <p>Your cart is empty. Start shopping now!</p>
                <a asp-controller="Product" asp-action="All" class="btn btn-primary mt-3">Shop Now</a>
            </div>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th></th> @* For image *@
                        <th>
                            @Html.DisplayNameFor(model => model.Prod_Name)
                        </th>
                        <th>
                            Price
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Quantity)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.EffectivePrice)
                        </th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@Url.Content(item.ImageUrl)" style="width:70px; height:auto;" alt="Product Image" />
                                }
                                else
                                {
                                    <span>No Image</span>
                                }
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Prod_Name)
                            </td>
                            <td>
                                @item.Price.ToString("C") @* Display original price *@
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Quantity)
                            </td>
                            <td>
                                @item.TotalPrice.ToString("C") @* EffectivePrice is total for this item *@
                            </td>
                            <td class="action-buttons">
                                <a asp-route-PId="@item.Prod_Id" asp-action="Increment" class="btn btn-primary btn-sm">+</a>
                                <a asp-route-PId="@item.Prod_Id" asp-action="Decrement" class="btn btn-warning btn-sm">-</a>
                                <a asp-action="Delete" asp-route-PId="@item.Prod_Id" class="btn btn-danger btn-sm">Remove</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="total-cost">Total Cart Cost: @((decimal)ViewBag.TotalCost)</div>

            <div class="cart-actions">
                <a asp-action="DeleteAll" class="btn btn-danger">Clear Cart</a>
                <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary">Proceed to Checkout</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
