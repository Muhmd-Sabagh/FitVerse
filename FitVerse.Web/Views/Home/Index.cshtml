@model FitVerse.Web.ViewModels.Home.HomeViewModel

@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Ensure correct layout is used
}

@section Styles {
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <style>
        /* General styles for the home page */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9fa; /* Light background */
            color: #333;
        }

        /* Hero section / Banner slider */
        .swiper-container {
            width: 100%;
            height: 450px; /* Adjusted height for banners */
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            margin-bottom: 50px;
        }

        .swiper-slide {
            display: flex;
            align-items: center;
            justify-content: center;
            background-size: cover;
            background-position: center;
            color: white;
            text-align: center;
            position: relative;
        }
        .swiper-slide::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.4); /* Dark overlay */
            z-index: 1;
        }

        .banner-content {
            position: relative;
            z-index: 2;
            max-width: 80%;
            padding: 20px;
        }
        .banner-content h2 {
            font-size: 3.5em;
            font-weight: 700;
            margin-bottom: 15px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        }
        .banner-content p {
            font-size: 1.3em;
            margin-bottom: 30px;
            text-shadow: 1px 1px 3px rgba(0,0,0,0.5);
        }
        .btn-banner {
            background-color: #ff006e; /* Accent color */
            color: white;
            padding: 15px 30px;
            border-radius: 30px;
            text-decoration: none;
            font-size: 1.1em;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 6px 20px rgba(255, 0, 110, 0.3);
        }
        .btn-banner:hover {
            background-color: #cc0058;
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(255, 0, 110, 0.4);
        }

        /* Categories Section */
        .categories-section {
            padding: 50px 0;
        }
        .section-title {
            font-size: 2.5em;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 40px;
            text-align: center;
        }
        .category-card {
            text-align: center;
            margin-bottom: 30px;
            transition: transform 0.3s ease;
        }
        .category-card:hover {
            transform: translateY(-5px);
        }
        .category-card img {
            width: 150px;
            height: 150px;
            object-fit: cover;
            border-radius: 50%;
            border: 5px solid #fff;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
        }
        .category-card:hover img {
            border-color: #3a86ff; /* Primary color */
            box-shadow: 0 8px 20px rgba(58, 134, 255, 0.2);
        }
        .category-card h5 {
            margin-top: 15px;
            font-weight: 600;
            color: #444;
        }
        .category-card a {
            text-decoration: none;
            color: inherit;
        }
        .category-card a:hover h5 {
            color: #3a86ff;
        }

        /* Products Section (similar to product list, but simpler cards) */
        .products-section {
            padding: 50px 0;
            background-color: #f0f2f5;
        }
        .product-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            margin-bottom: 30px;
            display: flex;
            flex-direction: column;
            height: 100%; /* Ensure cards are same height */
        }
        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.12);
        }
        .product-card-img-container {
            position: relative;
            overflow: hidden;
            padding-top: 100%; /* 1:1 Aspect Ratio */
            border-bottom: 1px solid #eee;
        }
        .product-card img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }
        .product-card:hover img {
            transform: scale(1.05);
        }
        .product-card-body {
            padding: 20px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            text-align: center;
        }
        .product-card-title {
            font-size: 1.2em;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 10px;
            height: 2.4em; /* Limit title to 2 lines */
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }
        .product-card-price {
            font-size: 1.4em;
            font-weight: 700;
            color: #3a86ff; /* Primary color */
            margin-top: auto; /* Push price to bottom */
        }
        .btn-view-all {
            display: inline-block;
            margin-top: 20px;
            padding: 12px 30px;
            background-color: #8338ec; /* Secondary color */
            color: white;
            border-radius: 30px;
            text-decoration: none;
            font-size: 1.1em;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 6px 20px rgba(131, 56, 236, 0.2);
        }
        .btn-view-all:hover {
            background-color: #6a2dc4;
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(131, 56, 236, 0.3);
        }

        /* Media Queries for Responsiveness */
        @@media (max-width: 768px) {
            .swiper-container {
                height: 300px;
            }
            .banner-content h2 {
                font-size: 2.5em;
            }
            .banner-content p {
                font-size: 1em;
            }
            .section-title {
                font-size: 2em;
            }
            .category-card img {
                width: 100px;
                height: 100px;
            }
            .product-card-title {
                font-size: 1.1em;
            }
            .product-card-price {
                font-size: 1.2em;
            }
        }
        @@media (max-width: 576px) {
            .swiper-container {
                height: 250px;
            }
            .banner-content h2 {
                font-size: 2em;
                margin-bottom: 10px;
            }
            .banner-content p {
                font-size: 0.9em;
                margin-bottom: 20px;
            }
            .btn-banner {
                padding: 10px 20px;
                font-size: 1em;
            }
            .section-title {
                font-size: 1.8em;
            }
        }
    </style>
}

<main>
    <!-- Banner Slider -->
    @if (Model.Banners != null && Model.Banners.Any())
    {
        <div class="swiper-container">
            <div class="swiper-wrapper">
                @foreach (var banner in Model.Banners)
                {
                    <div class="swiper-slide" style="background-image: url('@Url.Content(banner.ImageUrl)');">
                        <div class="banner-content">
                            <h2>@banner.Title</h2>
                            <p>@banner.Description</p>
                            <a href="#" class="btn-banner">Shop Now</a> @* Link to a generic shop page or specific banner link *@
                        </div>
                    </div>
                }
            </div>
            <!-- Add Pagination -->
            <div class="swiper-pagination"></div>
            <!-- Add Navigation -->
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
        </div>
    }

    <!-- Categories Section -->
    @if (Model.Categories != null && Model.Categories.Any())
    {
        <section class="categories-section container">
            <h2 class="section-title">Shop by Category</h2>
            <div class="row text-center">
                @foreach (var category in Model.Categories)
                {
                    <div class="col-6 col-md-3">
                        <div class="category-card">
                            <a asp-controller="Product" asp-action="Category" asp-route-category="@category.Name">
                                @if (!string.IsNullOrEmpty(category.ImageUrl))
                                {
                                    <img src="@Url.Content(category.ImageUrl)" alt="@category.Name" class="img-fluid rounded-circle">
                                }
                                else
                                {
                                    <img src="https://placehold.co/150x150/cccccc/333333?text=No+Image" alt="No Image" class="img-fluid rounded-circle" />
                                }
                                <h5>@category.Name</h5>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <!-- Featured Products Section -->
    @if (Model.Products != null && Model.Products.Any())
    {
        <section class="products-section container">
            <h2 class="section-title">Featured Products</h2>
            <div class="row">
                @foreach (var product in Model.Products)
                {
                    <div class="col-lg-3 col-md-4 col-sm-6 d-flex align-items-stretch">
                        <div class="product-card">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">
                                <div class="product-card-img-container">
                                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                                    {
                                        <img src="@Url.Content(product.ImageUrl)" alt="@product.Name" class="img-fluid">
                                    }
                                    else
                                    {
                                        <img src="https://placehold.co/400x400/cccccc/333333?text=No+Image" alt="No Image" class="img-fluid" />
                                    }
                                </div>
                                <div class="product-card-body">
                                    <h3 class="product-card-title">@product.Name</h3>
                                    <p class="product-card-price">@product.Price.ToString("C")</p>
                                </div>
                            </a>
                        </div>
                    </div>
                }
            </div>
            <div class="text-center mt-4">
                <a asp-controller="Product" asp-action="All" class="btn-view-all">View All Products</a>
            </div>
        </section>
    }
</main>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>
        // Swiper initialization
        var swiper = new Swiper('.swiper-container', {
            loop: true,
            autoplay: {
                delay: 5000, // 5 seconds
                disableOnInteraction: false,
            },
            pagination: {
                el: '.swiper-pagination',
                clickable: true,
            },
            navigation: {
                nextEl: '.swiper-button-next',
                prevEl: '.swiper-button-prev',
            },
        });
    </script>
}
