@model FitVerse.Web.ViewModels.Account.RegisterViewModel

@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Ensure correct layout is used
}

<style>
    /* Basic styling for the registration form - consider moving to a dedicated CSS file */
    body {
        background: linear-gradient(135deg, #f8f8f8, #ffffff);
        font-family: 'Inter', sans-serif; /* Using Inter font */
        color: #444;
    }

    h1 {
        text-align: center;
        color: #333;
        font-weight: bold;
        font-size: 2.2rem;
        margin-bottom: 0.5rem;
    }

    h4 {
        text-align: center;
        color: #666;
        font-size: 1.2rem;
        margin-bottom: 1.5rem;
    }

    .form-container {
        background-color: #fff;
        padding: 2.5rem;
        border-radius: 20px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
        margin-top: 40px;
        border: 1px solid #e0e0e0;
    }

    .form-control {
        background-color: #f9f9f9;
        border: 1px solid #ccc;
        color: #333;
        border-radius: 8px;
        padding: 0.75rem;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #3a86ff; /* Primary color */
            box-shadow: 0 0 0 0.2rem rgba(58, 134, 255, 0.25);
            background-color: #fff;
            color: #000;
        }

    .btn-primary {
        background-color: #3a86ff; /* Primary color */
        border-color: #3a86ff;
        border-radius: 8px;
        padding: 0.75rem 1.5rem;
        font-size: 1.1rem;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(58, 134, 255, 0.2);
    }

        .btn-primary:hover {
            background-color: #2a6ae0; /* Darker shade on hover */
            border-color: #2a6ae0;
            box-shadow: 0 6px 15px rgba(58, 134, 255, 0.3);
            transform: translateY(-2px);
        }

    .text-danger {
        font-size: 0.9em;
    }
</style>

<div class="container d-flex justify-content-center py-5">
    <div class="col-md-6 form-container">
        <h1>Register</h1>
        <h4>Create a new account.</h4>
        <hr />
        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="FullName" class="control-label mb-1"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label mb-1"></label>
                <input asp-for="Email" class="form-control" type="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Password" class="control-label mb-1"></label>
                <input asp-for="Password" class="form-control" type="password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-group mb-4">
                <label asp-for="ConfirmPassword" class="control-label mb-1"></label>
                <input asp-for="ConfirmPassword" class="form-control" type="password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <div class="form-group text-center">
                <input type="submit" value="Create Account" class="btn btn-primary w-100" />
            </div>
        </form>
        <div class="text-center mt-3">
            <span>Already have an account?</span>
            <a asp-action="Login" class="fs-5 text-primary fw-bold">Login</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
