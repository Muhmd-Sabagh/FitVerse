@model FitVerse.Web.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<h1 class="text-center">Register</h1>
<h4 class="text-center">Create a New Account</h4>
<hr />

<div class="row justify-content-center pb-5">
    <div class="col-md-6 form-container">
        <form asp-action="Register">
            <div class="form-group mb-3">
                <label asp-for="FullName" class="control-label mb-1"></label>
                <input asp-for="FullName" class="form-control" type="text" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label mb-1"></label>
                <input asp-for="Email" class="form-control" type="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Password" class="control-label mb-1"></label>
                <input asp-for="Password" class="form-control" type="password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-group mb-4">
                <label asp-for="ConfirmPassword" class="control-label mb-1"></label>
                <input asp-for="ConfirmPassword" class="form-control" type="password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <div class="form-group text-center">
                <input type="submit" value="Create Account" class="btn btn-primary w-100" />
            </div>
        </form>
        <div class="text-center mt-3">
            <span>Already have an account?</span>
            <a asp-action="Login" class="fs-5">Login</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
