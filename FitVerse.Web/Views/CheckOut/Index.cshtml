@model FitVerse.Web.ViewModels.Checkout.Checkout_ViewModel

@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Ensure correct layout is used
}

<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #f0f2f5;
        color: #333;
    }
    .card {
        border-radius: 12px;
        border: none;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    }
    .card-title {
        color: #2c3e50;
        font-weight: 700;
    }
    .card-subtitle {
        color: #6c757d;
        font-weight: 600;
    }
    .form-label {
        font-weight: 600;
        color: #555;
    }
    .form-control {
        border-radius: 8px;
        border: 1px solid #ddd;
        padding: 10px 15px;
        font-size: 1em;
    }
    .form-control:focus {
        border-color: #3a86ff;
        box-shadow: 0 0 0 0.2rem rgba(58, 134, 255, 0.25);
    }
    .btn-success {
        background-color: #28a745;
        border-color: #28a745;
        border-radius: 8px;
        padding: 12px 25px;
        font-size: 1.1em;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(40, 167, 69, 0.2);
    }
    .btn-success:hover {
        background-color: #218838;
        border-color: #1e7e34;
        transform: translateY(-2px);
        box-shadow: 0 6px 15px rgba(40, 167, 69, 0.3);
    }
    .order-summary-item {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 10px 0;
        border-bottom: 1px dashed #eee;
    }
    .order-summary-item:last-child {
        border-bottom: none;
    }
    .order-summary-img {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }
    .order-summary-details {
        flex-grow: 1;
        text-align: left;
    }
    .order-summary-details h6 {
        margin-bottom: 5px;
        font-weight: 600;
        color: #2c3e50;
    }
    .order-summary-details p {
        margin-bottom: 0;
        color: #6c757d;
        font-size: 0.9em;
    }
    .order-summary-price {
        font-weight: 700;
        color: #333;
    }
    .total-summary {
        font-size: 1.4em;
        font-weight: 700;
        text-align: right;
        margin-top: 20px;
        color: #2c3e50;
    }
    .modal-content {
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    }
    .modal-header {
        border-bottom: none;
        padding-bottom: 0;
    }
    .modal-footer {
        border-top: none;
        padding-top: 0;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-md-12">
            <div class="card shadow-lg p-4">
                <h2 class="card-title text-center mb-4">Secure Checkout</h2>
                <form id="checkoutForm" class="row g-4"> @* Increased gap for better spacing *@

                    <div class="col-md-6">
                        <div class="card mb-3 h-100"> @* Added h-100 for consistent height *@
                            <div class="card-body">
                                <h3 class="card-subtitle mb-3 text-muted">Shipping Information</h3>
                                <div class="mb-3">
                                    <label asp-for="CustomerName" class="form-label">Full Name</label>
                                    <input asp-for="CustomerName" autocomplete="name" required class="form-control">
                                    <span asp-validation-for="CustomerName" class="text-danger"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="ShippingAddress" class="form-label">Address</label>
                                    <input type="text" asp-for="ShippingAddress" autocomplete="street-address" required class="form-control">
                                    <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                                </div>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label asp-for="CustomerEmail" class="form-label">Email</label>
                                        <input type="email" asp-for="CustomerEmail" autocomplete="email" required class="form-control">
                                        <span asp-validation-for="CustomerEmail" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="CustomerPhone" class="form-label">Phone</label>
                                        <input type="tel" asp-for="CustomerPhone" autocomplete="tel" required class="form-control">
                                        <span asp-validation-for="CustomerPhone" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card h-100"> @* Added h-100 for consistent height *@
                            <div class="card-body">
                                <h3 class="card-subtitle mb-3 text-muted">Order Summary</h3>
                                @if (Model != null && Model.CartItemsViewModels != null && Model.CartItemsViewModels.Any())
                                {
                                    <div class="order-summary-list">
                                        @foreach (var item in Model.CartItemsViewModels)
                                        {
                                            <div class="order-summary-item">
                                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                                {
                                                    <img src="@Url.Content(item.ImageUrl)" alt="Product Image" class="order-summary-img">
                                                }
                                                else
                                                {
                                                    <div class="order-summary-img d-flex align-items-center justify-content-center bg-light text-muted">No Img</div>
                                                }
                                                <div class="order-summary-details">
                                                    <h6>@item.Prod_Name</h6>
                                                    <p>Quantity: @item.Quantity</p>
                                                    <p>Unit Price: @item.EffectivePrice.ToString("C")</p>
                                                </div>
                                                <div class="order-summary-price">
                                                    @item.TotalPrice.ToString("C")
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <hr class="my-3">
                                    <div class="total-summary text-right">
                                        Total: @((decimal)ViewBag.TotalCost)
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted text-center">Your cart is empty.</p>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-12 text-center mt-4">
                        <button type="submit" class="btn btn-success btn-lg">Place Order</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Custom Message Box Modal -->
<div class="modal fade" id="messageBox" tabindex="-1" aria-labelledby="messageBoxLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="messageBoxLabel">Notification</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="messageBoxContent">
                <!-- Message will be injected here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal" id="messageBoxOkButton">OK</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"
            xintegrity="sha384-ENjdO4Dr2bkBIFxQpeoTz1HIcje39Wm4jDKdf19U8gI4ddQ3GYNS7NTKfAdVQSZe"
            crossorigin="anonymous"></script>

    <script>
        document.getElementById('checkoutForm').addEventListener('submit', async function (event) {
            event.preventDefault(); // Prevent default form submission

            // Basic client-side validation
            if (!this.checkValidity()) {
                this.classList.add('was-validated');
                return;
            }

            const formData = {
                CustomerName: document.getElementById('CustomerName').value,
                ShippingAddress: document.getElementById('ShippingAddress').value,
                CustomerEmail: document.getElementById('CustomerEmail').value,
                CustomerPhone: document.getElementById('CustomerPhone').value,
                // OrderDate, UserId, Status, TotalAmount will be set on the server
            };

            try {
                const response = await fetch('@Url.Action("SaveOrder", "Checkout")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value // Include CSRF token
                    },
                    body: JSON.stringify(formData)
                });

                if (response.ok) {
                    const result = await response.json();
                    if (result.success) {
                        document.getElementById('messageBoxContent').textContent = 'Order placed successfully!';
                        var messageBox = new bootstrap.Modal(document.getElementById('messageBox'));
                        messageBox.show();
                        document.getElementById('messageBoxOkButton').onclick = function () {
                            window.location.href = result.redirectUrl; // Redirect to order details
                        };
                    } else {
                        document.getElementById('messageBoxContent').textContent = result.message || 'An error occurred while placing the order.';
                        var messageBox = new bootstrap.Modal(document.getElementById('messageBox'));
                        messageBox.show();
                    }
                } else {
                    const errorText = await response.text();
                    console.error('HTTP error:', response.status, errorText);
                    document.getElementById('messageBoxContent').textContent = `Error: ${response.status} - ${errorText.substring(0, 100)}...`; // Show part of the error
                    var messageBox = new bootstrap.Modal(document.getElementById('messageBox'));
                    messageBox.show();
                }
            } catch (error) {
                console.error('Fetch error:', error);
                document.getElementById('messageBoxContent').textContent = 'An unexpected error occurred. Please try again.';
                var messageBox = new bootstrap.Modal(document.getElementById('messageBox'));
                messageBox.show();
            }
        });
    </script>
}
